# Database Configuration
DB_HOST=localhost
DB_NAME=pharmacy_saas
DB_USER=root
DB_PASS=

# Application Configuration
APP_NAME="Pharmacy SaaS Platform"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRY=3600

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# SMS Gateway (Optional)
SMS_GATEWAY=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=

# File Storage
STORAGE_PATH=storage/
UPLOAD_MAX_SIZE=10485760

# Multi-tenant Configuration
TENANT_DOMAIN_PATTERN={tenant}.yourdomain.com
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar,ps,dr